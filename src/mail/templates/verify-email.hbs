<p style="margin:0 0 10px;font-size:28px;line-height:1.25;font-weight:800;letter-spacing:-0.03em;color:#0b1f3a;">
  Confirm your email
</p>
<p style="margin:0 0 22px;font-size:16px;line-height:1.65;color:#5b6b82;">
  Hi{{#if firstName}} {{firstName}}{{/if}}, enter this code in AUTHENTIC to confirm your email and protect your account.
</p>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 28px;background:#f7f9fc;border:1px solid #d5deeb;border-radius:16px;">
  <tr>
    <td style="padding:22px 18px 8px;text-align:center;font-size:11px;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:#1d4ed8;">
      Verification code
    </td>
  </tr>
  <tr>
    <td style="padding:4px 18px 22px;text-align:center;">
      <p style="margin:0;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:36px;line-height:1.2;font-weight:800;letter-spacing:0.28em;color:#0b1f3a;">
        {{code}}
      </p>
    </td>
  </tr>
</table>

<p style="margin:0 0 18px;font-size:13px;line-height:1.6;color:#5b6b82;">
  This code expires in 24 hours. Prefer a one-tap link instead?
</p>

<table role="presentation" cellspacing="0" cellpadding="0" style="margin:0 0 28px;">
  <tr>
    <td style="border-radius:14px;background:#1d4ed8;">
      <a href="{{{verifyUrl}}}" style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:800;color:#ffffff;text-decoration:none;letter-spacing:-0.01em;">
        Verify email
      </a>
    </td>
  </tr>
</table>

<p style="margin:0 0 18px;font-size:13px;line-height:1.6;color:#5b6b82;">
  Button not working? Paste this URL into your browser:
</p>
<p style="margin:0 0 28px;padding:14px 16px;background:#eef3fb;border:1px solid #d5deeb;border-radius:12px;font-size:12px;line-height:1.5;word-break:break-all;color:#1d4ed8;">
  {{{verifyUrl}}}
</p>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 8px;background:#f7f9fc;border:1px solid #d5deeb;border-radius:16px;">
  <tr>
    <td style="padding:18px 18px 8px;font-size:11px;font-weight:800;letter-spacing:0.14em;text-transform:uppercase;color:#1d4ed8;">
      API clients
    </td>
  </tr>
  <tr>
    <td style="padding:0 18px 16px;font-size:13px;line-height:1.6;color:#5b6b82;">
      Prefer code: <code style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:#0b1f3a;">POST /api/v1/auth/verify-email</code>
      with <code style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:#0b1f3a;">{ "email", "code" }</code>.
      Or send the deep-link token below as <code style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:#0b1f3a;">{ "token" }</code>.
    </td>
  </tr>
  <tr>
    <td style="padding:0 18px 18px;">
      <p style="margin:0;padding:12px 14px;background:#ffffff;border:1px solid #d5deeb;border-radius:10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.5;word-break:break-all;color:#0b1f3a;">
        {{token}}
      </p>
    </td>
  </tr>
</table>

<p style="margin:20px 0 0;font-size:13px;line-height:1.6;color:#5b6b82;">
  If you did not create an account, ignore this email.
</p>
