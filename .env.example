NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
APP_WEB_URL=http://localhost:3001

DATABASE_URL=postgresql://authentic:authentic@localhost:5432/authentic?schema=public
# Optional. On Render leave empty or set Upstash/Redis Cloud. localhost is ignored in production.
REDIS_URL=

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=14d

CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# r2 | s3 | local — or leave empty to auto-detect R2 when keys are set.
STORAGE_PROVIDER=r2
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
# Custom domain or r2.dev public URL, e.g. https://images.yourdomain.com
R2_PUBLIC_BASE_URL=

# Require email verification before login (default true). Set false only for local bypass.
EMAIL_VERIFICATION_REQUIRED=true
# true = return debugVerificationCode / debugResetCode in API (local only). false = never.
AUTH_DEBUG_TOKENS=true

# Mail: Resend first (if RESEND_API_KEY set), Nodemailer/Gmail SMTP as fallback.
# Leave EMAIL_PROVIDER empty for auto (resend → smtp → log). Force with: resend | smtp | log
EMAIL_PROVIDER=smtp
MAIL_FROM=AUTHENTIC <noreply@yourdomain.com>
RESEND_API_KEY=
# Gmail SMTP fallback — App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=log

IDENTITY_SIGNING_SECRET=replace-with-product-identity-hmac-secret

# Blockchain identity anchoring (hash commitments — no PII on-chain).
# Keep false until RPC + signer + registry are configured.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_CHAIN_KEY=polygon-amoy
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_REGISTRY_ADDRESS=

SWAGGER_ENABLED=true
THROTTLE_PUBLIC=60
THROTTLE_JWT=120
THROTTLE_API_KEY=300

# Leave empty until you have keys. Then checkout turns on automatically.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# true = new orgs stay PENDING until an admin approves them
ORG_KYC_REQUIRED=false

# Optional worldwide ISBN/product lookup. Open Library and Open Food Facts work without keys.
GOOGLE_BOOKS_API_KEY=
CATALOG_LOOKUP_UPCITEMDB=false
