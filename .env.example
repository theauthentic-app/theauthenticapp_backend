NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
APP_WEB_URL=http://localhost:3001

DATABASE_URL=postgresql://authentic:authentic@localhost:5432/authentic?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=14d

CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Leave empty to auto-detect: Cloudflare R2 when R2 keys are set, otherwise local.
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
# Custom domain or r2.dev public URL, e.g. https://images.yourdomain.com
R2_PUBLIC_BASE_URL=

# Leave empty to auto-detect: Resend when RESEND_API_KEY is set, otherwise log.
EMAIL_PROVIDER=
MAIL_FROM=AUTHENTIC <noreply@yourdomain.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=log

IDENTITY_SIGNING_SECRET=replace-with-product-identity-hmac-secret

SWAGGER_ENABLED=true
THROTTLE_PUBLIC=60
THROTTLE_JWT=120
THROTTLE_API_KEY=300

# Leave empty until you have keys. Then checkout turns on automatically.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# true = new orgs stay PENDING until an admin approves them
ORG_KYC_REQUIRED=false

# Optional worldwide ISBN/product lookup. Open Library and Open Food Facts work without keys.
GOOGLE_BOOKS_API_KEY=
CATALOG_LOOKUP_UPCITEMDB=false
